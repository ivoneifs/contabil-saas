# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/contabil_saas?schema=public"

# Autenticação
JWT_SECRET="troque-por-um-valor-aleatorio-forte"

# Gateway fiscal (Focus NFe) — crie sua própria conta em https://focusnfe.com.br
# Deixe em branco em dev: a emissão de notas retornará erro 503 explicando
# que o gateway não está configurado, em vez de simular uma nota fiscal falsa.
FOCUS_NFE_TOKEN=""
FOCUS_NFE_BASE_URL="https://homologacao.focusnfe.com.br"

PORT=3001

# Chave do cofre (AES-256) que cifra certificados A1 e chaves de APIs.
# Sem ela, o cofre deriva a chave do JWT_SECRET. Trocar depois invalida o que já foi cifrado.
COFRE_KEY=""

# IA: o Super Admin cadastra as chaves em Super Admin > Chaves de IA.
# Sem chave cadastrada, o sistema usa estas variáveis (Anthropic primeiro).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Cadastro público de escritórios (/signup). Fechado por padrão: as contas
# são vendidas e criadas pelo Super Admin.
PERMITIR_CADASTRO_PUBLICO="false"
