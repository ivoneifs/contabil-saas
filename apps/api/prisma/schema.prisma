// Schema inicial do sistema SaaS para escritórios de contabilidade.
// Multi-tenant via organizationId em cada tabela de domínio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  CONTADOR
  ASSISTENTE
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum NotaFiscalTipo {
  NFE
  NFCE
}

enum NotaFiscalStatus {
  RASCUNHO
  ENVIADA
  AUTORIZADA
  REJEITADA
  CANCELADA
}

enum LancamentoTipo {
  A_PAGAR
  A_RECEBER
}

enum LancamentoStatus {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum ObrigacaoFiscalStatus {
  PENDENTE
  EM_ANALISE
  ENTREGUE
}

enum CompromissoStatus {
  AGENDADO
  REALIZADO
  CANCELADO
}

enum DocumentoCategoria {
  // Fiscais e de Operações
  NFE_ENTRADA
  NFE_SAIDA
  NFSE
  NFCE
  CTE
  XML_NOTA_FISCAL
  REDUCAO_Z_LEITURA_X
  SPED

  // Financeiros e Bancários
  EXTRATO_BANCARIO
  EXTRATO_APLICACAO
  EXTRATO_CARTAO
  COMPROVANTE_PAGAMENTO
  CONTRATO_EMPRESTIMO
  DUPLICATA_BOLETO
  CONTROLE_RECEBIMENTO

  // Despesas e Custos
  FATURA_ENERGIA
  FATURA_AGUA
  FATURA_TELEFONIA_INTERNET
  RECIBO_ALUGUEL
  COMPROVANTE_CONDOMINIO_IPTU

  // Trabalhistas e Previdenciários
  FOLHA_PAGAMENTO
  GUIA_FGTS
  COMPROVANTE_PROLABORE
  RECIBO_FERIAS_RESCISAO
  RECIBO_AUTONOMO_RPA

  // Tributários e Societários
  GUIA_DAS
  GUIA_DARF
  GUIA_ISS_ICMS
  CONTRATO_SOCIAL

  OUTRO
}

// Um escritório de contabilidade (tenant) usando o SaaS.
model Organization {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  // Controle de venda/licença, gerenciado pelo Super Admin.
  ativa       Boolean   @default(true)
  acessoAte   DateTime?
  plano       String?
  telefone    String?
  observacoes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]
  integracoes IntegracoesConfig?
  certificados CertificadoDigital[]

  @@map("organizations")
}

// Credenciais de integrações externas configuradas pelo próprio escritório
// (via tela de Configurações), em vez de variáveis de ambiente da plataforma.
// Se nulo, o sistema usa a credencial padrão da plataforma (env var), quando existir.
model IntegracoesConfig {
  id             String   @id @default(uuid())
  organizationId String   @unique
  focusNfeToken    String?
  focusNfeBaseUrl  String?
  asaasApiKey      String?
  // Segredos abaixo ficam cifrados com o cofre (src/common/cofre.ts).
  serproConsumerKey       String?
  serproConsumerSecret    String?
  nuvemFiscalClientId     String?
  nuvemFiscalClientSecret String?
  // Último resultado do teste de cada integração: { [id]: { ok, mensagem, em, ms } }
  testes                  Json?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("integracoes_config")
}

// Um usuário que pode pertencer a uma ou mais organizações (escritórios).
model User {
  id            String   @id @default(uuid())
  isSuperAdmin  Boolean  @default(false)
  ativo         Boolean  @default(true)
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

// Vínculo usuário <-> organização com papel (multi-tenancy).
model Membership {
  id             String         @id @default(uuid())
  role           MembershipRole @default(ASSISTENTE)
  // Quando personalizado = true, vale a lista "permissoes" marcada pelo
  // administrador; senão, as permissões padrão do papel (src/auth/permissoes.ts).
  personalizado  Boolean        @default(false)
  permissoes     String[]       @default([])
  organizationId String
  userId         String
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

// Empresa-cliente do escritório de contabilidade.
model Client {
  id               String            @id @default(uuid())
  organizationId   String
  razaoSocial      String
  nomeFantasia     String?
  cnpjCpf          String
  regimeTributario RegimeTributario?
  uf               String
  municipio        String?
  email            String?
  telefone         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notasFiscais NotaFiscal[]
  lancamentos  Lancamento[]
  funcionarios Funcionario[]
  compromissos Compromisso[]
  documentos   Documento[]
  obrigacoesFiscais ObrigacaoFiscal[]
  certificados CertificadoDigital[]
  documentosFiscais DocumentoFiscal[]
  folhas            FolhaPagamento[]
  eventosEsocial    EventoEsocial[]

  @@unique([organizationId, cnpjCpf])
  @@index([organizationId])
  @@map("clients")
}

// Documento fiscal (NFe/NFCe) emitido via gateway fiscal (ex: Focus NFe).
model NotaFiscal {
  id                String           @id @default(uuid())
  organizationId    String
  clientId          String
  tipo              NotaFiscalTipo
  status            NotaFiscalStatus @default(RASCUNHO)
  numero            String?
  serie             String?
  uf                String
  chaveAcesso       String?
  gatewayProvider   String? // ex: "focusnfe"
  gatewayExternalId String? // id/referência da nota no gateway
  xmlUrl            String?
  danfeUrl          String?
  valorTotal        Decimal          @db.Decimal(12, 2)
  motivoRejeicao    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("notas_fiscais")
}

// Módulo Financeiro: contas a pagar/receber do cliente.
model Lancamento {
  id             String           @id @default(uuid())
  organizationId String
  clientId       String
  tipo           LancamentoTipo
  status         LancamentoStatus @default(PENDENTE)
  descricao      String
  valor          Decimal          @db.Decimal(12, 2)
  vencimento     DateTime
  pagoEm         DateTime?
  boletoUrl      String? // quando emitido via Asaas
  asaasChargeId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("lancamentos")
}

// Módulo Pessoal: funcionários do cliente (base para folha de pagamento).
model Funcionario {
  id             String    @id @default(uuid())
  organizationId String
  clientId       String
  nome           String
  cpf            String
  cargo          String?
  salarioBase    Decimal   @db.Decimal(12, 2)
  dataAdmissao   DateTime
  dataDemissao   DateTime?
  // Departamento pessoal (Etapa 2)
  vinculo        VinculoTrabalho @default(EMPREGADO)
  matricula      String?
  pis            String?
  cbo            String?
  dataNascimento DateTime?
  dependentesIrrf Int      @default(0)
  jornadaMensal  Int       @default(220)
  valeTransporte Boolean   @default(false)
  pensaoAlimenticia Decimal? @db.Decimal(12, 2)
  email          String?
  itensFolha     ItemFolha[]
  calculos       CalculoTrabalhista[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("funcionarios")
}

// Módulo Agenda: compromissos/reuniões com o cliente.
model Compromisso {
  id             String            @id @default(uuid())
  organizationId String
  clientId       String
  titulo         String
  descricao      String?
  inicio         DateTime
  fim            DateTime
  status         CompromissoStatus @default(AGENDADO)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@index([inicio])
  @@map("compromissos")
}

// Documentos do cliente: notas fiscais, extratos bancários e outros arquivos.
// Armazenados diretamente no banco (bytea) — adequado para o volume de um
// escritório de contabilidade; se o volume crescer muito, trocar por um
// object storage (S3-compatível) é uma migração isolada a este módulo.
model Documento {
  id             String             @id @default(uuid())
  organizationId String
  clientId       String
  categoria      DocumentoCategoria @default(OUTRO)
  nomeArquivo    String
  mimeType       String
  tamanhoBytes   Int
  conteudo       Bytes
  createdAt      DateTime           @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("documentos")
}

// Módulo Kanban: obrigações fiscais recorrentes por cliente (ex: DAS, DEFIS,
// declarações mensais), rastreadas por status até a entrega.
model ObrigacaoFiscal {
  id             String                @id @default(uuid())
  organizationId String
  clientId       String
  titulo         String
  competencia    String // ex: "2026-08" (mês/ano de referência)
  prazo          DateTime
  status         ObrigacaoFiscalStatus @default(PENDENTE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("obrigacoes_fiscais")
}

// Certificado digital A1 (.pfx). Sem clientId = certificado do próprio
// escritório (usado como contratante/procurador no SERPRO e no eSocial).
// O arquivo e a senha ficam cifrados; os metadados ficam em claro para
// listagem e alerta de vencimento.
model CertificadoDigital {
  id             String   @id @default(uuid())
  organizationId String
  clientId       String?
  titular        String
  documento      String? // CNPJ ou CPF extraído do certificado
  emissor        String?
  validoDe       DateTime
  validoAte      DateTime
  pfxCifrado     Bytes
  senhaCifrada   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@map("certificados_digitais")
}

enum ProvedorIa {
  OPENAI
  ANTHROPIC
}

// Chaves de API de IA da plataforma, gerenciadas pelo Super Admin.
// A chave fica cifrada (src/common/cofre.ts); "final" guarda só os 4 últimos
// caracteres para exibição. A chave marcada como padrão (e ativa) é a usada
// pelo assistente, pela agenda inteligente e pelos modelos.
model ChaveIa {
  id           String     @id @default(uuid())
  provedor     ProvedorIa
  nome         String
  chaveCifrada String
  final        String
  modelo       String?
  ativa        Boolean    @default(true)
  padrao       Boolean    @default(false)
  ultimoTeste  DateTime?
  ultimoErro   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("chaves_ia")
}

// Aparência e dados comerciais da plataforma (uma linha só, id "plataforma"),
// editados pelo Super Admin. Cores em hexadecimal (#rrggbb).
model ConfiguracaoPlataforma {
  id            String   @id @default("plataforma")
  nomeSistema   String   @default("Genesis IA Contabilidade")
  corPrimaria   String   @default("#6366f1")
  corSecundaria String   @default("#8b5cf6")
  corDestaque   String   @default("#c8ff4d")
  whatsapp      String   @default("5574988258825")
  precoAVista   Int      @default(4000)
  parcelas      Int      @default(10)
  valorParcela  Int      @default(500)
  updatedAt     DateTime @updatedAt

  @@map("configuracao_plataforma")
}

enum ModeloDocFiscal {
  NFE
  NFCE
  CTE
  CTEOS
  MDFE
  NFSE
  EVENTO
  DESCONHECIDO
}

enum FormatoArquivoFiscal {
  XML
  PDF
}

enum DirecaoDocFiscal {
  ENTRADA
  SAIDA
}

// Arquivo fiscal enviado pelo escritório: XML (NF-e, NFC-e, CT-e, MDF-e,
// NFS-e, eventos) ou a representação gráfica em PDF (DANFE, DANFC-e,
// DACTE, DAMDFE). Os dados vêm da leitura do XML; o PDF é ligado ao XML
// pela chave de acesso. "hash" evita importar o mesmo arquivo duas vezes.
model DocumentoFiscal {
  id                String               @id @default(uuid())
  organizationId    String
  clientId          String?
  modelo            ModeloDocFiscal
  formato           FormatoArquivoFiscal
  direcao           DirecaoDocFiscal?
  chaveAcesso       String?
  numero            String?
  serie             String?
  dataEmissao       DateTime?
  emitenteDoc       String?
  emitenteNome      String?
  destinatarioDoc   String?
  destinatarioNome  String?
  valorTotal        Decimal?             @db.Decimal(14, 2)
  naturezaOperacao  String?
  protocolo         String?
  situacao          String? // AUTORIZADA, CANCELADA, DENEGADA, SEM_PROTOCOLO
  descricaoEvento   String?
  nomeArquivo       String
  mimeType          String
  tamanhoBytes      Int
  hash              String
  conteudo          Bytes
  createdAt         DateTime             @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, hash])
  @@index([organizationId, modelo])
  @@index([organizationId, chaveAcesso])
  @@index([organizationId, dataEmissao])
  @@index([clientId])
  @@map("documentos_fiscais")
}

enum VinculoTrabalho {
  EMPREGADO
  APRENDIZ
  SOCIO
  ESTAGIARIO
}

enum StatusFolha {
  ABERTA
  FECHADA
}

// Folha mensal de um cliente. Os valores de cada pessoa ficam em ItemFolha.
model FolhaPagamento {
  id             String      @id @default(uuid())
  organizationId String
  clientId       String
  competencia    String // AAAA-MM
  status         StatusFolha @default(ABERTA)
  totalBruto     Decimal     @default(0) @db.Decimal(14, 2)
  totalInss      Decimal     @default(0) @db.Decimal(14, 2)
  totalIrrf      Decimal     @default(0) @db.Decimal(14, 2)
  totalFgts      Decimal     @default(0) @db.Decimal(14, 2)
  totalLiquido   Decimal     @default(0) @db.Decimal(14, 2)
  fechadaEm      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itens  ItemFolha[]

  @@unique([clientId, competencia])
  @@index([organizationId, competencia])
  @@map("folhas_pagamento")
}

// Uma pessoa na folha: lançamentos do mês (entrada) e o cálculo (saída).
model ItemFolha {
  id            String   @id @default(uuid())
  folhaId       String
  funcionarioId String
  lancamentos   Json // horasExtras50, horasExtras100, faltasDias, outrosProventos, outrosDescontos
  resultado     Json // rubricas e bases
  bruto         Decimal  @db.Decimal(12, 2)
  inss          Decimal  @db.Decimal(12, 2)
  irrf          Decimal  @db.Decimal(12, 2)
  fgts          Decimal  @db.Decimal(12, 2)
  liquido       Decimal  @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  folha       FolhaPagamento @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  funcionario Funcionario    @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([folhaId, funcionarioId])
  @@map("itens_folha")
}

enum TipoCalculoTrabalhista {
  FERIAS
  RESCISAO
  DECIMO_TERCEIRO
}

// Férias, rescisões e 13º calculados e guardados (recibo/termo).
model CalculoTrabalhista {
  id             String                 @id @default(uuid())
  organizationId String
  funcionarioId  String
  tipo           TipoCalculoTrabalhista
  parametros     Json
  resultado      Json
  liquido        Decimal                @db.Decimal(12, 2)
  createdAt      DateTime               @default(now())

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([organizationId, tipo])
  @@map("calculos_trabalhistas")
}

enum StatusEventoEsocial {
  PENDENTE
  ENVIADO
  DISPENSADO
}

// Eventos do eSocial que o escritório precisa transmitir, gerados a partir
// de admissões, desligamentos e folhas fechadas. O envio é registrado com o
// número do recibo.
model EventoEsocial {
  id             String              @id @default(uuid())
  organizationId String
  clientId       String
  funcionarioId  String?
  evento         String // S-2200, S-2299, S-1200, S-1299…
  descricao      String
  referencia     String // competência ou data do fato
  prazo          DateTime
  status         StatusEventoEsocial @default(PENDENTE)
  recibo         String?
  observacao     String?
  chave          String // evita duplicar o mesmo evento
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, chave])
  @@index([organizationId, status])
  @@map("eventos_esocial")
}
